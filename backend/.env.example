# Kopiere diese Datei nach ".env" und trage echte Werte ein.
# Die .env-Datei wird NICHT ins Git-Repository hochgeladen (.gitignore)!

# Langer Zufallswert. Erzeugen mit:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# --- Lokal ohne Docker: SQLite ---
DATABASE_URL=sqlite:///dev.db
# Lokal läuft alles über http://, daher Secure-Cookies aus. In Produktion (HTTPS): true
SESSION_COOKIE_SECURE=false
RATELIMIT_STORAGE_URI=memory://
TRUST_PROXY=false

# Adressen des Frontends, die auf die API zugreifen dürfen (kommagetrennt).
# 5500 = VS Code "Live Server", 8080 = nginx aus docker-compose
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# --- Nur für docker-compose (PostgreSQL) ---
POSTGRES_USER=atheismus
POSTGRES_PASSWORD=bitte-aendern
POSTGRES_DB=atheismus
